# Copy to apps/website/.env (never committed) for local deploys with `pnpm website:deploy`.
# Alternatively run `pnpm --filter @alisio/website exec wrangler login` and set only the account.
CLOUDFLARE_ACCOUNT_ID=
# API token with "Workers Scripts: Edit" (account) and "Workers Routes: Edit" + "DNS: Edit"
# (zone alisioair.com) permissions. Leave empty when you use `wrangler login`.
CLOUDFLARE_API_TOKEN=
