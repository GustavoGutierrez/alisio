{
  "name": "@alisio/plugin-memory",
  "version": "0.4.4",
  "description": "Engram-style persistent memory for Alisio: SQLite FTS5 observations with topic-key upserts, memory-aware compaction, session summaries and recall tools. Built-in, disableable plugin.",
  "author": "Gustavo Gutiérrez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio.git",
    "directory": "packages/plugin-memory"
  },
  "homepage": "https://gustavogutierrez.github.io/alisio/",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "agent-harness",
    "openai-compatible",
    "alisio-plugin",
    "plugins",
    "memory",
    "fts5",
    "sqlite"
  ],
  "type": "module",
  "exports": {
    ".": {
      "alisio-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@alisio/sdk": "workspace:^"
  },
  "devDependencies": {
    "@alisio/sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://registry.npmjs.com/"
  }
}
