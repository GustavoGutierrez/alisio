{
  "name": "@alisio/plugin-material-icons",
  "version": "0.5.0",
  "description": "Material Icon Theme for the Alisio web UI: a self-contained icon-theme provider with the vendored Material Icon Theme SVGs and VSCode-style manifest.",
  "author": "Gustavo Gutiérrez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio.git",
    "directory": "packages/plugin-material-icons"
  },
  "homepage": "https://gustavogutierrez.github.io/alisio/",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "agent-harness",
    "openai-compatible",
    "alisio-plugin",
    "plugins",
    "icon-theme",
    "material-icon-theme",
    "icons"
  ],
  "type": "module",
  "exports": {
    ".": {
      "alisio-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "icons",
    "material-icons.json",
    "LICENSE",
    "LICENSE.material-icon-theme"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@alisio/sdk": "workspace:^"
  },
  "devDependencies": {
    "@alisio/sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://registry.npmjs.com/"
  }
}
