{
  "name": "@alisio/core",
  "version": "0.1.0",
  "description": "Embeddable provider-agnostic Alisio agent core: tool loop, context compaction, local tools, MCP, plugin host and SQLite session store. Runs on Node >=22.16 and Bun.",
  "author": "Gustavo Gutiérrez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio.git",
    "directory": "packages/core"
  },
  "homepage": "https://gustavogutierrez.github.io/alisio/",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "agent-harness",
    "openai-compatible",
    "plugins",
    "mcp",
    "agent"
  ],
  "type": "module",
  "exports": {
    ".": {
      "alisio-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@alisio/sdk": "workspace:*",
    "@mixmark-io/domino": "2.2.0",
    "@modelcontextprotocol/client": "2.1.0",
    "ajv": "8.20.0",
    "turndown": "7.2.4",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://registry.npmjs.com/"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6"
  }
}
