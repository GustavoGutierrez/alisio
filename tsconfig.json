{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["alisio-source"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "fixtures/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts",
    "apps/website/.vitepress/**/*.ts"
  ],
  "exclude": ["packages/web/**", "tests/fixtures/eval/**"]
}
