{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!apps/desktop/build",
      "!apps/desktop/release",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!test-results",
      "!playwright-report",
      "!apps/website/.vitepress/cache",
      "!apps/website/.vitepress/dist",
      "!packs",
      "!packages/core/src/analysis/python/alisio_runtime/chart.umd.min.js",
      "!packages/core/src/analysis/python/alisio_runtime/charts-boot.js",
      "!packages/core/src/analysis/python/alisio_runtime/*.css",
      "!apps/website/benchmark-*.json",
      "!specs/012-context-governor-v1-fase6-g1.json",
      "!.stryker-tmp",
      "!.atl",
      "!.vitest",
      "!tests/fixtures/eval"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
