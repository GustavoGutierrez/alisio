{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!docs/.vitepress/cache",
      "!docs/.vitepress/dist",
      "!packs",
      "!packages/core/src/analysis/python/alisio_runtime/chart.umd.min.js",
      "!packages/core/src/analysis/python/alisio_runtime/charts-boot.js",
      "!packages/core/src/analysis/python/alisio_runtime/*.css",
      "!packages/plugin-material-icons/material-icons.json",
      "!packages/plugin-material-icons/icons",
      "!docs/benchmark-*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
